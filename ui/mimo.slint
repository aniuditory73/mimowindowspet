import { Button, LineEdit, ProgressIndicator, ScrollView } from "std-widgets.slint";

export struct NoteView { label: string, text: string }

export component MimoTray inherits SystemTrayIcon {
    in property <image> tray-image;
    callback open-panel();
    callback hide-window();
    callback exit-app();

    tooltip: "MIMO";
    icon: root.tray-image;
    clicked => { root.open-panel(); }

    Menu {
        MenuItem { title: @tr("Открыть MIMO"); activated => { root.open-panel(); } }
        MenuItem { title: @tr("Скрыть островок"); activated => { root.hide-window(); } }
        MenuSeparator {}
        MenuItem { title: @tr("Выйти"); activated => { root.exit-app(); } }
    }
}

export component MimoWindow inherits Window {
    in property <bool> expanded;
    in property <bool> pinned: true;
    in property <image> window-icon;
    in-out property <bool> settings-open;
    in-out property <bool> notes-open;
    in property <[NoteView]> notes;
    in-out property <string> note-text;
    in property <string> notes-summary;
    in-out property <string> notes-query;
    in property <[string]> corners;
    in property <int> selected-corner;
    in property <bool> saving;
    in property <string> settings-message;
    in-out property <string> command;
    in property <string> message;
    in property <string> task-name;
    in property <string> task-status;
    in property <float> task-progress;
    in property <bool> can-cancel;
    in property <bool> show-progress;
    in property <bool> can-submit: true;
    callback toggle-panel();
    callback toggle-pin();
    callback submit-command(string) -> bool;
    callback run-check();
    callback find-notes(string);
    callback cancel-task();
    callback select-corner(int);
    callback exit-app();
    callback refresh();

    title: "MIMO";
    icon: root.window-icon;
    no-frame: true;
    width: root.expanded ? 420px : 100px;
    height: root.expanded ? 286px : 42px;
    background: transparent;
    default-font-family: "Segoe UI";
    default-font-size: 14px;

    function send-command() {
        if (root.can-submit && root.submit-command(root.command)) {
            root.command = "";
        }
    }

    if !root.expanded: Rectangle {
        forward-focus: island-focus;
        background: island-touch.pressed ? #303244 : island-touch.has-hover ? #252734 : #14151d;
        border-radius: 21px;
        border-width: 1px;
        border-color: #555769;

        accessible-role: button;
        accessible-label: @tr("Открыть MIMO");
        accessible-action-default => { root.toggle-panel(); }

        Text {
            text: "MIMO";
            color: #f4f4fb;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
        island-touch := TouchArea { clicked => { root.toggle-panel(); } }
        island-focus := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Space || event.text == Key.Return) {
                    root.toggle-panel();
                    return accept;
                }
                return reject;
            }
        }
        if island-focus.has-focus: Rectangle {
            x: 3px; y: 3px; width: parent.width - 6px; height: parent.height - 6px;
            border-radius: 18px;
            border-width: 1px;
            border-color: #cbd1ef;
        }
    }

    if root.expanded: Rectangle {
        background: @linear-gradient(150deg, #1b1d28 0%, #121319 100%);
        border-radius: 20px;
        border-width: 1px;
        border-color: #494b5d;

        VerticalLayout {
            padding: 14px;
            spacing: 9px;

            HorizontalLayout {
                spacing: 8px;
                height: 34px;
                Text { text: "MIMO"; color: #f4f4fb; font-weight: 700; font-size: 19px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: root.pinned ? @tr("Закреплено") : @tr("Закрепить");
                    accessible-label: root.pinned ? @tr("Открепить от верхнего слоя окон") : @tr("Закрепить поверх окон");
                    primary: root.pinned;
                    enabled: !root.saving;
                    clicked => { root.toggle-pin(); }
                }
                Button {
                    text: root.settings-open || root.notes-open ? @tr("К задачам") : @tr("Настройки");
                    clicked => {
                        if (root.notes-open) { root.notes-open = false; }
                        else { root.settings-open = !root.settings-open; }
                    }
                }
                Button { text: @tr("Свернуть"); clicked => { root.toggle-panel(); } }
            }

            if root.settings-open: VerticalLayout {
                spacing: 8px;
                Text { text: @tr("Угол рабочего экрана"); color: #ededf7; }
                for corner[index] in root.corners: Button {
                    text: corner;
                    primary: root.selected-corner == index;
                    enabled: !root.saving;
                    height: 30px;
                    clicked => { root.select-corner(index); }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: root.settings-message; color: #d3d4e5; vertical-alignment: center; overflow: elide; }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Выйти"); clicked => { root.exit-app(); } }
                }
            }

            if root.notes-open: VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    height: 34px;
                    LineEdit {
                        text <=> root.notes-query;
                        placeholder-text: @tr("Поиск по заметкам");
                        accessible-label: @tr("Поиск по заметкам");
                        accepted => { if (root.can-submit) { root.find-notes(root.notes-query); } }
                    }
                    Button { text: @tr("Найти"); enabled: root.can-submit; clicked => { root.find-notes(root.notes-query); } }
                }
                if root.note-text == "": ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        for note in root.notes: Button { text: note.label; clicked => { root.note-text = note.text; } }
                    }
                }
                if root.note-text != "": ScrollView {
                    vertical-stretch: 1;
                    Text { text: root.note-text; color: #ededf7; wrap: word-wrap; }
                }
                HorizontalLayout {
                    height: 34px;
                    spacing: 8px;
                    Text { text: root.note-text == "" ? root.notes-summary : @tr("Заметка"); color: #d3d4e5; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    if root.note-text != "": Button { text: @tr("К списку"); clicked => { root.note-text = ""; } }
                }
            }

            if !root.settings-open && !root.notes-open: VerticalLayout {
                spacing: 9px;
                HorizontalLayout {
                    spacing: 8px;
                    height: 32px;
                    Button { text: @tr("Проверка отклика"); enabled: root.can-submit; clicked => { root.run-check(); } }
                    Button { text: @tr("Заметки"); enabled: root.can-submit; clicked => { root.notes-query = ""; root.find-notes(""); } }
                    Rectangle { horizontal-stretch: 1; }
                }

                Rectangle {
                    background: #222431;
                    border-radius: 12px;
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 5px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: root.task-name; color: #f4f4fb; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                            if root.can-cancel: Button { text: @tr("Отменить"); clicked => { root.cancel-task(); } }
                        }
                        Text { text: root.task-status; color: #cfd1e3; }
                        if root.show-progress: ProgressIndicator { progress: root.task-progress; }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                Text {
                    text: root.message;
                    color: #d3d4e5;
                    overflow: elide;
                    height: 18px;
                }
                HorizontalLayout {
                    spacing: 8px;
                    height: 36px;
                    LineEdit {
                        text <=> root.command;
                        placeholder-text: @tr("Введите команду");
                        accessible-label: @tr("Команда");
                        accepted => { root.send-command(); }
                    }
                    Button { text: @tr("Запустить"); enabled: root.can-submit; clicked => { root.send-command(); } }
                }
            }
        }
    }
}
